# SMTP 設定（關鍵字訂閱 Email 通知用）。複製成 .env 後填入，或在 GitHub Secrets 設定同名變數。
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-account@gmail.com
SMTP_PASS=your-app-password
# 寄件者顯示，未設則用 SMTP_USER
NOTIFY_FROM=政府標案平台 <your-account@gmail.com>

# 爬蟲禮貌設定（秒）
SCRAPE_MIN_DELAY=1.5
SCRAPE_MAX_DELAY=3.5
# 單次每日爬取詳情頁上限（避免過量請求；0 = 不限制）
SCRAPE_MAX_DETAILS=0

# 應用資料庫位置
DATABASE_URL=sqlite:///data/app.db
